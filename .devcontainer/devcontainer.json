{
  "name": "Airway RNA-seq: FASTQ to featureCounts",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "AIRWAY_SPOTS": "200000"
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash scripts/init_workspace.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "RNA-seq output downloads",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
